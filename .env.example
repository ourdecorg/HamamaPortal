# Copy to .env.local for local development. On Railway, add the same variables in the service settings.
# Full setup guide: docs/SUPABASE.md
#
# Without SUPABASE_URL / SUPABASE_ANON_KEY the app still runs, in read-only DEMO mode with the JSON
# files in /data/projects (no sign-in, nothing is saved).

# ── Required at runtime, locally and on Railway ─────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
# The anon / publishable key. Safe to expose: Row Level Security protects the data.
SUPABASE_ANON_KEY=

# ── Recommended in production ───────────────────────────────────────────────────────────────────
# The public origin of the site, used for sign-in return links. It must also be listed in
# Supabase → Authentication → URL Configuration → Redirect URLs (as <SITE_URL>/auth/callback).
# Locally, http://localhost:3000 is detected automatically.
# SITE_URL=https://your-app.up.railway.app

# ── ONLY for the CLI scripts (npm run db:seed, npm run steward:approve) ────────────────────────
# The service-role key bypasses Row Level Security. Keep it in .env.local on a trusted machine.
# NEVER add it to Railway, and never prefix it with NEXT_PUBLIC_. The web app does not read it.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Optional: reserved for a future LLM-backed discovery provider (not read today) ─────────────
# ANTHROPIC_API_KEY=
